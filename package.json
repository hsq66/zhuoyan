  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hsq66/zhuoyan/issues"
  },
  "homepage": "https://github.com/hsq66/zhuoyan#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0"
  }
}
