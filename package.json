{
  "name": "zhuoyan-hugo",
  "version": "1.0.0",
  "description": "卓研知识库与支持中心 - 基于 Hugo 和 Dot 主题",
  "main": "index.js",
  "scripts": {
    "dev": "hugo server --disableFastRender --buildDrafts --buildFuture",
    "build": "hugo --gc --minify",
    "preview": "hugo server --disableFastRender",
    "clean": "rm -rf public resources .hugo_build.lock"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsq66/zhuoyan.git"
  },
  "keywords": [
    "hugo",
    "documentation",
    "knowledge-base",
    "support-center"
  ],
